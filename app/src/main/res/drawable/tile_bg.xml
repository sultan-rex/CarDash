<?xml version="1.0" encoding="utf-8"?>
<!-- A filled card: the main surface style of the refined-minimal look. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/card_pressed">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/card_stroke" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
