<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingBottom="24dp"
    android:paddingEnd="32dp"
    android:paddingStart="32dp"
    android:paddingTop="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="32dp"
        android:layout_weight="6"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/d_back"
                style="@style/IconButton"
                android:contentDescription="Back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/d_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text"
                android:textSize="26sp" />

            <ImageButton
                android:id="@+id/d_prev"
                style="@style/IconButton"
                android:contentDescription="Previous month"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/d_next"
                style="@style/IconButton"
                android:contentDescription="Next month"
                android:rotation="180"
                android:src="@drawable/ic_back" />
        </LinearLayout>

        <com.sulthan.cardash.CalendarGridView
            android:id="@+id/d_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/d_date"
            style="@style/StatLabel"
            android:text="--" />

        <TextView
            android:id="@+id/d_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:text="--"
            android:textColor="@color/text"
            android:textSize="76sp" />

        <TextView
            android:id="@+id/d_km_unit"
            style="@style/StatLabel"
            android:layout_marginBottom="20dp"
            android:text="km driven" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/FuelCell">
                <TextView android:id="@+id/d_top" style="@style/FuelValue" />
                <TextView style="@style/StatLabel" android:text="Top speed" />
            </LinearLayout>

            <LinearLayout style="@style/FuelCell">
                <TextView android:id="@+id/d_time" style="@style/FuelValue" />
                <TextView style="@style/StatLabel" android:text="Time moving" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/FuelCell">
                <TextView android:id="@+id/d_avg" style="@style/FuelValue" />
                <TextView style="@style/StatLabel" android:text="Average speed" />
            </LinearLayout>

            <LinearLayout style="@style/FuelCell">
                <TextView android:id="@+id/d_month_km" style="@style/FuelValue" />
                <TextView style="@style/StatLabel" android:text="This month" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/FuelCell">
                <TextView android:id="@+id/d_month_days" style="@style/FuelValue" />
                <TextView style="@style/StatLabel" android:text="Days driven" />
            </LinearLayout>

            <LinearLayout style="@style/FuelCell">
                <TextView android:id="@+id/d_month_top" style="@style/FuelValue" />
                <TextView style="@style/StatLabel" android:text="Month top speed" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/d_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="No drives recorded yet.\nDrives are recorded from the OBD-II adapter's speed, or from GPS when Location is on."
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
