<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.sulthan.cardash.PagerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/page_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="18dp"
            android:paddingEnd="@dimen/edge_safe"
            android:paddingStart="@dimen/edge_safe"
            android:paddingTop="12dp">

            <!-- Top bar: clock, connection status, settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/text"
                    android:textSize="50sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="@color/text_dim"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:background="@drawable/pill_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="14dp"
                    android:paddingStart="6dp">

                <ImageButton
                    android:id="@+id/btn_theme"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Day or night theme"
                    android:padding="12dp"
                    android:src="@drawable/ic_moon" />

                <ImageButton
                    android:id="@+id/btn_location"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Location"
                    android:padding="12dp"
                    android:src="@drawable/ic_location" />

                <ImageButton
                    android:id="@+id/btn_autostart"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Start Android Auto when a phone connects"
                    android:padding="12dp"
                    android:src="@drawable/ic_car" />

                <ImageButton
                    android:id="@+id/btn_wifi"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Wi-Fi"
                    android:padding="12dp"
                    android:src="@drawable/ic_wifi" />

                <ImageButton
                    android:id="@+id/btn_bt"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Bluetooth"
                    android:padding="12dp"
                    android:src="@drawable/ic_bluetooth" />

                <ImageView
                    android:id="@+id/obd_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/dot" />

                <TextView
                    android:id="@+id/obd_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_settings"
                    style="@style/IconButton"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_tune"
                    android:tint="@color/text_dim" />
            </LinearLayout>

            <!-- The horizon: speed arc with the speed in the middle, sliders at the side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/stats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <com.sulthan.cardash.HorizonView
                        android:id="@+id/horizon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="72dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stat_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-thin"
                            android:includeFontPadding="false"
                            android:text="--"
                            android:textColor="@color/text"
                            android:textSize="92sp" />

                        <TextView
                            android:id="@+id/stat_speed_label"
                            style="@style/StatLabel"
                            android:text="km/h" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/MiniStat">
                            <TextView android:id="@+id/stat_rpm" style="@style/MiniStatValue" />
                            <TextView style="@style/StatLabel" android:text="RPM" />
                        </LinearLayout>

                        <LinearLayout style="@style/MiniStat">
                            <TextView android:id="@+id/stat_coolant" style="@style/MiniStatValue" />
                            <TextView style="@style/StatLabel" android:text="Coolant" />
                        </LinearLayout>

                        <LinearLayout style="@style/MiniStat">
                            <TextView android:id="@+id/stat_volt" style="@style/MiniStatValue" />
                            <TextView style="@style/StatLabel" android:text="Battery" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.sulthan.cardash.VerticalSliderView
                            android:id="@+id/sl_brightness"
                            android:layout_width="44dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:contentDescription="Brightness" />

                        <ImageButton
                            android:id="@+id/btn_dim"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/round_ripple"
                            android:contentDescription="Lowest brightness"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_brightness"
                            android:tint="@color/text_dim" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.sulthan.cardash.VerticalSliderView
                            android:id="@+id/sl_volume"
                            android:layout_width="44dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:contentDescription="Volume" />

                        <ImageButton
                            android:id="@+id/btn_mute"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/round_ripple"
                            android:contentDescription="Mute"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_volume"
                            android:tint="@color/text_dim" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Round launch buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tile_aa"
                    style="@style/RoundButton">

                    <ImageView
                        android:id="@+id/tile_aa_icon"
                        style="@style/RoundButtonIcon"
                        android:src="@drawable/ic_car" />

                    <TextView style="@style/RoundButtonLabel" android:text="Android Auto" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/tile_gauges"
                    style="@style/RoundButton">

                    <ImageView
                        style="@style/RoundButtonIcon"
                        android:src="@drawable/ic_speed" />

                    <TextView style="@style/RoundButtonLabel" android:text="Gauges" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_home_fuel"
                    style="@style/RoundButton">

                    <ImageView
                        style="@style/RoundButtonIcon"
                        android:src="@drawable/ic_fuel" />

                    <TextView style="@style/RoundButtonLabel" android:text="Fuel" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_home_drives"
                    style="@style/RoundButton">

                    <ImageView
                        style="@style/RoundButtonIcon"
                        android:src="@drawable/ic_calendar" />

                    <TextView style="@style/RoundButtonLabel" android:text="Drives" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_home_hud"
                    style="@style/RoundButton">

                    <ImageView
                        style="@style/RoundButtonIcon"
                        android:src="@drawable/ic_hud" />

                    <TextView style="@style/RoundButtonLabel" android:text="HUD" />
                </LinearLayout>
            </LinearLayout>

            <!-- Now playing, one slim bar -->
            <LinearLayout
                android:id="@+id/now_playing"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="10dp"
                android:paddingStart="10dp">

                <ImageView
                    android:id="@+id/np_art"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/art_bg"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music"
                    android:tint="@color/text_dim" />

                <TextView
                    android:id="@+id/np_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-light"
                    android:maxLines="1"
                    android:maxWidth="380dp"
                    android:text="Nothing playing"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/np_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-light"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/np_prev"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:contentDescription="Previous"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/np_play"
                    style="@style/IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="10dp"
                    android:contentDescription="Play or pause"
                    android:src="@drawable/cd_ic_play"
                    android:tint="@color/accent" />

                <ImageButton
                    android:id="@+id/np_next"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:contentDescription="Next"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_gauges"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="18dp"
            android:paddingEnd="@dimen/edge_safe"
            android:paddingStart="@dimen/edge_safe"
            android:paddingTop="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">


            <com.sulthan.cardash.SpeedoView
                android:id="@+id/g_speedo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:layout_weight="5" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.sulthan.cardash.GaugeView
                        android:id="@+id/g_rpm"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:decimals="0"
                        app:maxValue="8000"
                        app:minValue="0"
                        app:title="RPM"
                        app:unit="rpm"
                        app:warnValue="6000" />

                    <com.sulthan.cardash.GaugeView
                        android:id="@+id/g_coolant"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:decimals="0"
                        app:maxValue="130"
                        app:minValue="40"
                        app:title="Coolant"
                        app:unit="°C"
                        app:warnValue="105" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.sulthan.cardash.GaugeView
                        android:id="@+id/g_throttle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:decimals="0"
                        app:maxValue="100"
                        app:minValue="0"
                        app:title="Throttle"
                        app:unit="%" />

                    <com.sulthan.cardash.GaugeView
                        android:id="@+id/g_load"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:decimals="0"
                        app:maxValue="100"
                        app:minValue="0"
                        app:title="Engine load"
                        app:unit="%" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.sulthan.cardash.GaugeView
                        android:id="@+id/g_volt"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:decimals="1"
                        app:maxValue="16"
                        app:minValue="10"
                        app:title="Battery"
                        app:unit="V"
                        app:warnValue="15" />

                    <LinearLayout
                        android:id="@+id/btn_dtc"
                        style="@style/RoundButton">

                        <ImageView
                            style="@style/RoundButtonIcon"
                            android:src="@drawable/ic_warning"
                            android:tint="@color/warn" />

                        <TextView style="@style/RoundButtonLabel" android:text="Fault codes" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            </LinearLayout>

            <!-- Today's figures in one card, then round buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/pill_bg"
                    android:divider="@drawable/divider_v"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/s_top_day" style="@style/FuelValue" android:textSize="22sp" />
                        <TextView style="@style/StatLabel" android:text="Top today" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/s_top_month" style="@style/FuelValue" android:textSize="22sp" />
                        <TextView style="@style/StatLabel" android:text="Top this month" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/s_km_day" style="@style/FuelValue" android:textSize="22sp" />
                        <TextView android:id="@+id/s_km_day_label" style="@style/StatLabel" android:text="Driven today" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_service"
                    style="@style/RoundButton"
                    android:layout_width="96dp"
                    android:layout_weight="0">

                    <ImageView
                        style="@style/RoundButtonIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="15dp"
                        android:src="@drawable/ic_wrench" />

                    <TextView
                        android:id="@+id/s_service"
                        style="@style/RoundButtonLabel"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Service"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_hud"
                    style="@style/RoundButton"
                    android:layout_width="96dp"
                    android:layout_weight="0">

                    <ImageView
                        style="@style/RoundButtonIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="15dp"
                        android:src="@drawable/ic_hud" />

                    <TextView
                        style="@style/RoundButtonLabel"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="HUD"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_drives"
                    style="@style/RoundButton"
                    android:layout_width="96dp"
                    android:layout_weight="0">

                    <ImageView
                        style="@style/RoundButtonIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="15dp"
                        android:src="@drawable/ic_calendar" />

                    <TextView
                        style="@style/RoundButtonLabel"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Drives"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_fuel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingBottom="22dp"
            android:paddingEnd="@dimen/edge_safe"
            android:paddingStart="@dimen/edge_safe"
            android:paddingTop="16dp">

            <!-- Left: average consumption on a Horizon arc, the figures in two cards -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="28dp"
                android:layout_weight="5"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="330dp">

                    <com.sulthan.cardash.HorizonView
                        android:id="@+id/fuel_arc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/fuel_avg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-thin"
                            android:includeFontPadding="false"
                            android:text="--"
                            android:textColor="@color/text"
                            android:textSize="72sp" />

                        <TextView
                            android:id="@+id/fuel_avg_unit"
                            style="@style/StatLabel"
                            android:text="L/100 km average" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/pill_bg"
                    android:divider="@drawable/divider_v"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/fuel_last" style="@style/FuelValue" android:textSize="20sp" />
                        <TextView style="@style/StatLabel" android:text="Last fill-up" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/fuel_best" style="@style/FuelValue" android:textSize="20sp" />
                        <TextView style="@style/StatLabel" android:text="Best" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/fuel_range" style="@style/FuelValue" android:textSize="20sp" />
                        <TextView style="@style/StatLabel" android:text="Per fill" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/pill_bg"
                    android:divider="@drawable/divider_v"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/fuel_cost_km" style="@style/FuelValue" android:textSize="20sp" />
                        <TextView style="@style/StatLabel" android:text="Cost / distance" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/fuel_month" style="@style/FuelValue" android:textSize="20sp" />
                        <TextView style="@style/StatLabel" android:text="This month" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/fuel_total" style="@style/FuelValue" android:textSize="20sp" />
                        <TextView style="@style/StatLabel" android:text="Total spent" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Right: the fill-ups -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:text="Fill-ups"
                            android:textColor="@color/text"
                            android:textSize="26sp" />

                        <TextView
                            style="@style/StatLabel"
                            android:text="Tap one to copy or delete" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_fuel_add"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/pill_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingEnd="22dp"
                        android:paddingStart="22dp"
                        android:text="+  Add fill-up"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/fuel_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="10dp"
                        android:listSelector="@android:color/transparent"
                        android:scrollbars="none" />

                    <TextView
                        android:id="@+id/fuel_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="No fill-ups yet.\nTap Add fill-up after you refuel."
                        android:textColor="@color/text_dim"
                        android:textSize="16sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </com.sulthan.cardash.PagerView>

    <!-- Page dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dot_0"
            android:layout_width="28dp"
            android:layout_height="3dp"
            android:src="@drawable/page_bar"
            android:scaleType="fitXY"
            android:tint="@color/text" />

        <ImageView
            android:id="@+id/dot_1"
            android:layout_width="10dp"
            android:layout_height="3dp"
            android:layout_marginStart="8dp"
            android:alpha="0.3"
            android:src="@drawable/page_bar"
            android:scaleType="fitXY"
            android:tint="@color/text" />

        <ImageView
            android:id="@+id/dot_2"
            android:layout_width="10dp"
            android:layout_height="3dp"
            android:layout_marginStart="8dp"
            android:alpha="0.3"
            android:src="@drawable/page_bar"
            android:scaleType="fitXY"
            android:tint="@color/text" />

    </LinearLayout>
</FrameLayout>
