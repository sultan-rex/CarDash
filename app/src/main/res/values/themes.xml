<?xml version="1.0" encoding="utf-8"?>
<!-- Day themes (light). The night themes are in values-night/themes.xml. -->
<resources>
    <style name="CdAppTheme" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="SettingsTheme" parent="android:Theme.Material.Light">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/card</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
